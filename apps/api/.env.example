# Copie para apps/api/.env (ignorado pelo git). Sem nada configurado, a API sobe em memória,
# com AUTH_MODE=dev e os dados do seed do @cde/shared.

# Porta do servidor local (padrão 8787).
PORT=8787

# Supabase. Defina as duas juntas para usar o banco e o login reais.
# SUPABASE_SERVICE_ROLE_KEY recebe a chave SECRET (sb_secret_...). Nunca no app, nunca no git.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# dev: usuário pelo cabeçalho x-demo-user, sem senha (só demonstração).
# supabase: exige Authorization: Bearer <JWT do Supabase>.
# Padrão: supabase quando SUPABASE_* existe; dev quando não existe (em produção, dev só se explícito).
AUTH_MODE=

# Segredo para assinar os QR codes (texto longo e aleatório, 16+ caracteres). Obrigatório em produção.
# Ex.: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
QR_SECRET=

# Origens permitidas (separadas por vírgula), ex.: https://capim-dourado-experience.vercel.app
# Vazio fora de produção libera qualquer origem (*). Obrigatório em produção.
CORS_ORIGIN=http://localhost:5173

# true aceita os códigos de demonstração cde:<tipo>:<id> sem assinatura. false em produção.
ALLOW_DEMO_QR=true

# true ignora o horário do shopping. SÓ PARA DEMONSTRAÇÃO; nunca em produção.
SKIP_OPENING_HOURS=false

# Opcional: polígono da área de check-in, depois de conferido em campo. Tem prioridade sobre a
# tabela mall_area. Ex.: [{"lat":-10.1808,"lng":-48.3502},{"lat":-10.1808,"lng":-48.347},{"lat":-10.1845,"lng":-48.347},{"lat":-10.1845,"lng":-48.3502}]
MALL_AREA_JSON=
